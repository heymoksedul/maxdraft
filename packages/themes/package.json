{
  "name": "@maxdraft/themes",
  "version": "0.0.1",
  "description": "CSS variable-based themes for MaxDraft editor",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@maxdraft/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "sideEffects": ["./dist/*.css"]
}
