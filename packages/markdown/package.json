{
  "name": "@maxdraft/markdown",
  "version": "0.0.1",
  "description": "Markdown import/export for MaxDraft editor",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@maxdraft/shared": "workspace:*",
    "@tiptap/core": "^2.3.0",
    "markdown-it": "^14.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "sideEffects": false
}
