{
  "name": "@maxdraft/shared",
  "version": "0.0.1",
  "description": "Shared types, utilities and constants for MaxDraft",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@tiptap/core": "^2.3.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "sideEffects": false
}
